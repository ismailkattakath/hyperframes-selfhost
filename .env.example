# ---- Tailscale (Funnel runs ONLY in the stack container, not on Darwin host) -
# Admin → Settings → Keys → Generate auth key
# Recommended: Reusable ON, Ephemeral OFF, Tags optional, expiry e.g. 90 days
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_HOSTNAME=hyperframes

# ---- Public URL (HTTPS Funnel) -----------------------------------------------
# Leave EMPTY on first install. install.sh sets this after MagicDNS joins:
#   EXTERNAL_URL=https://<TS_HOSTNAME>.<tailnet>.ts.net
# compose needs a value at parse time — install bootstraps then rewrites.
EXTERNAL_URL=

# ---- Google OAuth Web application --------------------------------------------
# Cloud Console → Google Auth Platform → Clients → Web application
# Redirect URI (after install prints EXTERNAL_URL):
#   ${EXTERNAL_URL}/.auth/google/callback
# Consent: External audience. Prefer Production for long-lived MCP tokens;
# Testing is OK for smoke but refresh tokens expire ~7 days.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated exact emails (mcp-auth-proxy splitCSV trims spaces).
# MUST be non-empty: empty allowlist authorizes ANY Google account.
GOOGLE_ALLOWED_USERS=you@example.com

# ---- Workspace (media in/out) ------------------------------------------------
WORKSPACE_DIR=./workspace

# ---- Optional tuning ---------------------------------------------------------
CADDY_HTTP_PORT=8080
MCP_LISTEN=:8090
